set dotenv-load := true

export INTERACTIVE := env('INTERACTIVE', "true")

_default:
    @just --list

[doc("Build co-processor firmware with PlatformIO (make-backed incremental check).")]
build *ARGS:
    make {{ARGS}}

[doc("Generate compile_commands.json for clangd and Zed IDE integration.")]
compiledb:
    pio run -t compiledb

[doc("Format C++ sources and headers with clang-format (Google style).")]
fmt *ARGS:
    make fmt

[doc("Check C++ sources and headers formatting without modifying.")]
fmt-check *ARGS:
    make fmt-check

[doc("Run clang-tidy on co-processor C++ sources (make-backed incremental check).")]
tidy *ARGS:
    make tidy

[doc("Run host GoogleTest unit tests for co-processor.")]
test *ARGS:
    make test {{ARGS}}

[doc("Remove PlatformIO build artifacts and formatting/lint stamps.")]
[group("maintenance")]
clean:
    make clean

[doc("Run all verification steps for co-processor: formatting, lint, test, and build.")]
verify: fmt tidy test build

[doc("Build co-processor QEMU virtual test app using ESP-IDF.")]
qemu-build *ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -f "/Users/nilton/.espressif/v6.1/esp-idf/export.sh" ]; then
        . /Users/nilton/.espressif/v6.1/esp-idf/export.sh >/dev/null 2>&1
    fi
    idf.py -C qemu_app -B .cache/coprocessor/qemu build {{ARGS}}

[doc("Run co-processor inside QEMU with OpenEth virtual NIC and Tether UART1 on a pty.")]
qemu-run UART=".cache/coprocessor/qemu/uart1":
    qemu_app/run-qemu.sh {{UART}}

[doc("Run automated QEMU integration test suite.")]
qemu-test *ARGS:
    qemu_app/test-qemu.sh {{ARGS}}

[doc("Flash co-processor firmware via CH340 and monitor output (interactive, or automated via INTERACTIVE=false).")]
flash PORT="/dev/cu.usbserial-10" *ARGS:
    pio run -t upload --upload-port {{PORT}} {{ARGS}}
    if [ "$INTERACTIVE" = "true" ]; then \
        pio device monitor --port {{PORT}} --baud 115200; \
    else \
        just _monitor-expect {{PORT}}; \
    fi

[doc("Monitor co-processor UART output via CH340 (interactive, or automated via INTERACTIVE=false).")]
monitor PORT="/dev/cu.usbserial-10" *ARGS:
    if [ "$INTERACTIVE" = "true" ]; then \
        pio device monitor --port {{PORT}} --baud 115200 {{ARGS}}; \
    else \
        just _monitor-expect {{PORT}}; \
    fi

[doc("Reset the co-processor into normal running mode without attaching.")]
reset PORT="/dev/cu.usbserial-10":
    esptool -p {{PORT}} run

[private]
_monitor-expect PORT="/dev/cu.usbserial-10" TIMEOUT='15' TAIL='5':
    #!/usr/bin/env expect -f
    proc shutdown {pid code} {
        global spawn_id
        catch { send \003 }
        expect -timeout 5 {
            eof {}
            timeout {
                catch { exec kill -TERM -$pid }
                catch { expect -timeout 3 eof }
            }
        }
        catch { wait }
        exit $code
    }

    set timeout {{TIMEOUT}}
    set pid [spawn pio device monitor --port {{PORT}} --baud 115200]
    expect {
        "Co-Processor initialized" {
            # Device initialized: keep streaming for TAIL seconds to catch post-boot panics, crashes, or bootloops
            set timeout {{TAIL}}
            expect {
                -re "(Guru Meditation Error|abort\\(\\)|assert failed|Backtrace:)" {
                    set timeout 3
                    expect {
                        -re "(Rebooting|Restarting|CPU halted)" {}
                        timeout {}
                    }
                    send_user "\n*** Panic/crash detected after initialization!\n"
                    shutdown $pid 1
                }
                timeout {
                    send_user "\n=== Co-processor initialized and stable ===\n"
                    shutdown $pid 0
                }
                eof {
                    send_user "\n*** Serial port closed unexpectedly\n"
                    shutdown $pid 1
                }
            }
        }
        -re "(Guru Meditation Error|abort\\(\\)|assert failed|Backtrace:)" {
            set timeout 3
            expect {
                -re "(Rebooting|Restarting|CPU halted)" {}
                timeout {}
            }
            send_user "\n*** Panic/crash detected during boot!\n"
            shutdown $pid 1
        }
        timeout {
            send_user "\n*** Timed out waiting for co-processor initialization ({{TIMEOUT}}s)\n"
            shutdown $pid 1
        }
        eof {
            send_user "\n*** Serial monitor exited before initialization\n"
            exit 1
        }
    }
