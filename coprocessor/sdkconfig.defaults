CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
# Sockets: the web server and outgoing HTTP share them (see src/main.cpp).
CONFIG_LWIP_MAX_SOCKETS=16
# Status reads "down" a few seconds into an outage (net/network.h).
CONFIG_ESP_NETIF_IP_LOST_TIMER_INTERVAL=5
# Event handlers send FlatBuffers to the S3 (services/wifi_service.cpp).
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
