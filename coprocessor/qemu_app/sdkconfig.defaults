CONFIG_IDF_TARGET="esp32"
# Single app, all flash after NVS and PHY data (as on the device).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# OpenEth virtual Ethernet for QEMU emulation
CONFIG_ETH_USE_OPENETH=y
CONFIG_ETH_TRANSMIT_MUTEX_ENABLE=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_HTTPD_WS_SUPPORT=y

# As on the device (../sdkconfig.defaults).
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_NETIF_IP_LOST_TIMER_INTERVAL=5
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
