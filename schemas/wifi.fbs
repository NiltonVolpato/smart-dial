include "tether.fbs";
include "common.fbs";

namespace CoprocessorProto;

table WifiConnectRequest {
    ssid: string;
    password: string;
}

table StartProvisioningRequest {
    timeout_seconds: uint32;
}

rpc_service Wifi {
    /// Starts joining a Wi-Fi network; progress arrives on System.Watch.
    Connect(WifiConnectRequest): Empty (timeout_ms: "1000");
    /// Opens an on-demand BLE Improv provisioning session; its state arrives
    /// on System.Watch.
    StartProvisioning(StartProvisioningRequest): Empty;
    /// Cancels any active BLE Improv provisioning session.
    StopProvisioning(Empty): Empty;
}
