include "tether.fbs";
include "common.fbs";

namespace CoprocessorProto;

enum WifiState : ubyte {
    /// No network to join.
    Disconnected = 0,
    /// Joining, or rejoining after a drop.
    Connecting = 1,
    Connected = 2,
    /// Gave up joining (the network may be gone) until the next Connect.
    Failed = 3,
}

table WifiStatus {
    state: WifiState;
    ip: uint32;  // IPv4 (see common.fbs); 0 unless Connected.
    ssid: string;  // The network being joined or joined; empty if none.
    rssi: int16;  // 0 unless Connected.
}

enum ProvisioningState : ubyte {
    Inactive = 0,
    Active = 1,
    Provisioned = 2,
    TimedOut = 3,
}

table ProvisioningStatus {
    state: ProvisioningState;
}

struct Timestamp {
    epoch_seconds: uint64;
    subsec_micros: uint32;
}

/// The clock synced over SNTP: the co-processor's time when it sent this.
table TimeSynced {
    timestamp: Timestamp;
}

union SystemEventKind {
    WifiStatus,
    ProvisioningStatus,
    TimeSynced,
}

table SystemEvent {
    event: SystemEventKind;
}

table BatteryStatus {
    millivolts: uint32;
    percent: uint8;
    is_plugged: bool;
}

/// System state and telemetry.
rpc_service System {
    /// Streams system events: first the current state (Wi-Fi, provisioning,
    /// and the time if synced), then each change. Only the latest of each
    /// kind is kept while the client hasn't caught up. One watcher: a new
    /// Watch ends the previous one.
    Watch(Empty): SystemEvent (streaming: "server");
    /// Reports battery state from the host ADC to the co-processor.
    ReportBattery(BatteryStatus): Empty;
}
