include "tether.fbs";
include "common.fbs";

namespace CoprocessorProto;

struct Timestamp {
    epoch_seconds: uint64;
    subsec_micros: uint32;
}

table GetTimestampRequest {}
table GetTimestampResponse {
    timestamp: Timestamp;
}

table BatteryStatus {
    millivolts: uint32;
    percent: uint8;
    is_plugged: bool;
}

/// System telemetry and network clock synchronization service.
rpc_service System {
    /// Requests the current time from the coprocessor. The coprocessor will
    /// already sync the time via SNTP when WiFi is connected.
    GetTimestamp(GetTimestampRequest): GetTimestampResponse;
    /// Reports battery state from the host ADC to the co-processor.
    ReportBattery(BatteryStatus): Empty;
}
