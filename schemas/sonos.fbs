include "tether.fbs";
include "common.fbs";

namespace CoprocessorProto;

// Speakers are addressed by IPv4 (see common.fbs). Sonos serves UPnP on port
// 1400, always, so no message carries a port.

// Playback state of a media renderer
enum TransportState : ubyte {
    Stopped = 0,
    Playing = 1,
    Paused = 2,
    Transitioning = 3,
}

// Media transport action to execute on a renderer
enum ActionType : ubyte {
    Play = 0,
    Pause = 1,
    TogglePlayPause = 2,
    Next = 3,
    Previous = 4,
    Stop = 5,
}

// Command from Host to Co-processor to perform a media transport action.
table ActionRequest {
    endpoint_ip: uint32;
    action: ActionType;
}

// Command to set or adjust volume on a renderer.
table VolumeRequest {
    endpoint_ip: uint32;
    volume: int16;        // 0..100 for absolute, or signed delta if is_relative
    is_relative: bool;    // If true, volume is treated as signed delta
}

// Track metadata
table TrackMetadata {
    title: string;
    artist: string;
    album: string;
    duration_seconds: uint32 = null;
    elapsed_seconds: uint32 = null;
    album_art_uri: string;
}

// Current media state update pushed from Co-processor to Host.
table StateUpdate {
    endpoint_ip: uint32;
    transport_state: TransportState = null;
    volume: uint8 = null;
    is_muted: bool = null;
    track: TrackMetadata;
}

// Discovered speaker member in a zone group
table Member {
    name: string;
    uuid: string;
    ip: uint32;
}

// Discovered group/room in the household.
table Group {
    id: string;
    name: string;
    coordinator_ip: uint32;
    is_playing: bool;
    members: [Member];
}

// Household topology update pushed from Co-processor to Host
table TopologyUpdate {
    sequence: uint32;
    group_index: uint16;
    total_groups: uint16;
    group: Group;
}

// A Sonos speaker found on the network.
table Speaker {
    ip: uint32;
}

// Request to watch household topology using a seed speaker IP (any speaker
// in the household: see Discover).
table TopologyRequest {
    seed_ip: uint32;
}

// Request to watch playback state on a group coordinator endpoint.
table PlaybackRequest {
    endpoint_ip: uint32;
}

// The groups to summarize, by coordinator: the client knows them from its
// topology stream.
table GroupsSummaryRequest {
    coordinator_ips: [uint32];
}

// Summarized state of a single speaker group for the carousel
table GroupSummary {
    coordinator_ip: uint32;  // As in the request.
    is_playing: bool;
    title: string;
}

table AlbumArtRequest {
    endpoint_ip: uint32;
    uri: string;  // TrackMetadata.album_art_uri: a path on the speaker.
}

// A piece of an album art image, in order.
table AlbumArtChunk {
    total_size: uint32;  // In the first chunk: the image's size; 0 if unknown.
    data: [ubyte];       // At most Limits.MaxAlbumArtChunk bytes.
}

rpc_service Sonos {
    WatchTopology(TopologyRequest): TopologyUpdate (streaming: "server");
    WatchPlayback(PlaybackRequest): StateUpdate (streaming: "server");
    Action(ActionRequest): CoprocessorProto.Empty (timeout_ms: "2000");
    SetVolume(VolumeRequest): CoprocessorProto.Empty (timeout_ms: "1000");
    /// Summarizes each coordinator's group, one at a time in request order,
    /// sending each as soon as it's known; then ends. A speaker that doesn't
    /// answer still gets one, as not playing.
    GetGroupsSummary(GroupsSummaryRequest): GroupSummary (streaming: "server");
    /// Streams the image at `uri` on the speaker, then ends; or ends with an
    /// error (NOT_FOUND, UNAVAILABLE, ...). Only paths on the speaker.
    GetAlbumArt(AlbumArtRequest): AlbumArtChunk (streaming: "server");
    /// Looks for speakers with mDNS (_sonos._tcp), sending each one once as
    /// it answers, then ends OK after about 2 s, whether it found any or not.
    /// RESOURCE_EXHAUSTED while another Discover runs.
    Discover(CoprocessorProto.Empty): Speaker (streaming: "server");
}
